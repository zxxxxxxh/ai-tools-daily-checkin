@echo off
rem AI tools daily check-in. Auto-locates Node.js so no per-machine edits are needed.
rem Node resolution order: node-path.txt (written by register-task.ps1) -> node on PATH -> common install dirs
setlocal enabledelayedexpansion
cd /d "%~dp0"

set "NODE_EXE="

rem 1) node-path.txt generated by register-task.ps1 on this machine
if exist "%~dp0node-path.txt" (
    set "PARSED="
    for /f "usebackq eol=# delims=" %%L in ("%~dp0node-path.txt") do (
        if not defined PARSED (
            set "PARSED=1"
            if exist "%%~L" set "NODE_EXE=%%~L"
        )
    )
)
if defined NODE_EXE goto :found

rem 2) node on PATH
for /f "delims=" %%N in ('where node 2^>nul') do (
    if not defined NODE_EXE if exist "%%~N" set "NODE_EXE=%%~N"
)
if defined NODE_EXE goto :found

rem 3) common install locations
for %%C in (
    "%ProgramFiles%\nodejs\node.exe"
    "%ProgramFiles(x86)%\nodejs\node.exe"
    "%LocalAppData%\Programs\nodejs\node.exe"
    "%APPDATA%\nvm\node.exe"
) do (
    if not defined NODE_EXE if exist "%%~C" set "NODE_EXE=%%~C"
)
if defined NODE_EXE goto :found

echo [ERROR]^(run-checkin^) Node.js not found.> 1>&2
echo   Option 1: re-run register-task.ps1 so it writes node-path.txt for this machine.> 1>&2
echo   Option 2: create node-path.txt in project root with the full path to node.exe.> 1>&2
exit /b 2

:found
if not exist "%~dp0checkin.js" (
    echo [ERROR]^(run-checkin^) checkin.js is missing.>&2
    exit /b 3
)
echo [info]^(run-checkin^) using Node: %NODE_EXE%
rem Log output goes to checkin.log via lib/core/log.js (no redirect here to avoid double-writing).
"%NODE_EXE%" "%CD%\checkin.js"
exit /b %errorlevel%